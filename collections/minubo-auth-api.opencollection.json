{
  "opencollection": "1.0.0",
  "info": {
    "name": "Minubo Auth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a JWT issued to use as Bearer token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.minubo.com/auth/v1/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a signed JWT for use as a Bearer token. The token is valid for 20 minutes."
        }
      ]
    }
  ],
  "bundled": true
}